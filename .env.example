# ==============================================================================
# GridGuard AI — Environment Configuration Template
# ==============================================================================
# Duplicate this file as '.env' in the project root to override defaults.


# Application General Settings
GRIDGUARD_ENV=development
GRIDGUARD_LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8501

# Storage & Database Settings
GRIDGUARD_DB_PATH=database/gridguard.db

# Virtual Smart-Meter Simulator Configuration (Phase 2+)
SIMULATOR_NUM_METERS=50
SIMULATOR_REPORTING_INTERVAL_SEC=15
SIMULATOR_DEFAULT_FEEDER_ID=FEEDER_NORTH_01

# MQTT Streaming Broker Configuration (Future Streaming Transport)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_TELEMETRY=gridguard/telemetry/meters
MQTT_CLIENT_ID=gridguard-stream-agent

