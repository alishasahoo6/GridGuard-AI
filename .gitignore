# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets
.env
.env.local
.env.*.local

# Databases & local stores (preserve .gitkeep)
database/*
!database/.gitkeep
*.sqlite
*.sqlite3
*.db

# Logs (preserve .gitkeep)
logs/*
!logs/.gitkeep
*.log

# Data directories (preserve .gitkeep, ignore generated/raw datasets)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/synthetic/*
!data/synthetic/.gitkeep

# Trained Model Artifacts (preserve .gitkeep)
models/*
!models/.gitkeep
*.joblib
*.pkl
*.pt
*.onnx

# Generated Reports & Plots (preserve .gitkeep)
reports/*
!reports/.gitkeep
*.pdf
*.png
*.html

# Pytest / Testing cache
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

